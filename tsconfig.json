{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2025",
    "jsx": "react-jsx",
    "jsxImportSource": "@ringozz/react-godot",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "@ringozz/godot/assets"
    ]
  },
  "include": [
    "src"
  ]
}
