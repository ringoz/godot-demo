{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**"
  ]
}
